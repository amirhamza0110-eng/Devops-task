// Discover all containers via the Docker socket.
discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "10s"
}

// Low-cardinality labels only: container + compose service.
discovery.relabel "containers" {
  targets = discovery.docker.containers.targets
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.app.receiver]
}

loki.process "app" {
  // Only the app emits JSON. Promote `level` and `path` (route template, bounded set) to labels.
  // Everything else (status, duration_ms, msg) stays in the log line and is filtered with `| json`.
  stage.match {
    selector = "{service=\"app\"}"
    stage.json {
      expressions = { level = "level", path = "path" }
    }
    stage.labels {
      values = { level = "", path = "" }
    }
  }
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
